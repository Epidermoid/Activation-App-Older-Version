  - m_Id: 373785564377088
    m_Localized: "Osoite: Opettajantie 1\nAukioloaika:\nMa-Pe 9.00\u201315.00\n"
    m_Metadata:
      m_Items: []
  - m_Id: 377716520611840
    m_Localized: "Kansainv\xE4lisyyspalvelut"
    m_Metadata:
      m_Items: []
  - m_Id: 378551954665472
