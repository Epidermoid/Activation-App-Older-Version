      m_Calls: []
  m_text: "Terveyspalvelut Suomessa ovat laadukkaita ja kattavia. Julkinen terveydenhuolto
    toimii terveyskeskusten kautta, ja kiireellisiss\xE4 tilanteissa p\xE4ivystys
    auttaa. Lis\xE4ksi l\xF6ytyy yksityisi\xE4 l\xE4\xE4k\xE4reit\xE4, hammasl\xE4\xE4k\xE4reit\xE4
    ja apteekkeja.\n\nKela tukee terveydenhuollon kustannuksissa.\n Lis\xE4tietoa:
    https://www.kela.fi\n\nHyvinvointi ei ole vain terveytt\xE4 \u2013 se on my\xF6s
    liikuntaa, lepoa ja sosiaalisia suhteita. Suupohjassa on kuntosaleja, uimahalleja
    ja ulkoilualueita.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 953dc18794b4ed14587346cc6d05e072, type: 2}
